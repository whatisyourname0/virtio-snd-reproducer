+/* Complete one held PCM_INFO response after the guest's control timeout. */
+static void virtio_snd_test_control_cb(void *opaque)
+{
+    VirtIOSound *s = VIRTIO_SND(opaque);
+    virtio_snd_ctrl_command *cmd = s->test_control_command;
+
+    if (!cmd) {
+        return;
+    }
+
+    s->test_control_completing = true;
+    QTAILQ_INSERT_HEAD(&s->cmdq, cmd, next);
+    virtio_snd_process_cmdq(s);
+    s->test_control_completing = false;
+    s->test_control_command = NULL;
+    s->test_control_completed++;
+    error_report("virtio-snd lifetime test: completed delayed PCM_INFO control descriptor");
 }
 
