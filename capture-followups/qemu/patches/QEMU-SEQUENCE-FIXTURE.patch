+static uint16_t virtio_snd_capture_test_sequence_sample(uint64_t seed,
+                                                         uint64_t epoch,
+                                                         uint64_t frame,
+                                                         uint64_t channel)
+{
+    uint64_t x = seed ^ (epoch * VIRTIO_SND_SEQUENCE_EPOCH_MUL) ^
+                 (frame * VIRTIO_SND_SEQUENCE_FRAME_MUL) ^
+                 (channel * VIRTIO_SND_SEQUENCE_CHANNEL_MUL);
+
+    x ^= x >> 30;
+    x *= UINT64_C(0xbf58476d1ce4e5b9);
+    x ^= x >> 27;
+    x *= UINT64_C(0x94d049bb133111eb);
+    x ^= x >> 31;
+    return (uint16_t)(x >> 48);
+}
+
+static void virtio_snd_capture_test_sequence_feed(
+    VirtIOSoundPCMStream *stream, uint8_t *data, size_t size)
+{
+    VirtIOSound *vsnd = stream->s;
+    uint32_t frame_bytes = stream->as.nchannels * sizeof(uint16_t);
+    size_t i;
+
+    if (stream->as.fmt != AUDIO_FORMAT_S16 || stream->as.big_endian ||
+        stream->as.nchannels < 1 || stream->as.nchannels > 2 ||
+        !stream->capture_sequence_initialized ||
+        stream->capture_sequence_failed) {
+        stream->capture_sequence_failed = true;
+        error_report("VIRTIO_SND_SEQUENCE_INVALID stream=%" PRIu32
+                     " fmt=%u channels=%u initialized=%d",
+                     stream->id, stream->as.fmt, stream->as.nchannels,
+                     stream->capture_sequence_initialized);
+        return;
+    }
+
+    if (!stream->capture_sequence_reported) {
+        info_report("VIRTIO_SND_SEQUENCE_DATA stream=%" PRIu32
+                    " epoch=%" PRIu64 " first_frame=%" PRIu64
+                    " channels=%u seed=0x%016" PRIx64,
+                    stream->id, stream->capture_sequence_epoch,
+                    stream->capture_sequence_next_frame,
+                    stream->as.nchannels, vsnd->capture_test_seed);
+        stream->capture_sequence_reported = true;
+    }
+
+    for (i = 0; i < size; i++) {
+        uint32_t sample_byte = stream->capture_sequence_byte_offset %
+                               sizeof(uint16_t);
+        uint64_t channel = stream->capture_sequence_byte_offset /
+                           sizeof(uint16_t);
+        uint16_t sample = virtio_snd_capture_test_sequence_sample(
+            vsnd->capture_test_seed, stream->capture_sequence_epoch,
+            stream->capture_sequence_next_frame, channel);
+
+        data[i] = (sample >> (8 * sample_byte)) & 0xff;
+        stream->capture_sequence_byte_offset++;
+        if (stream->capture_sequence_byte_offset == frame_bytes) {
+            stream->capture_sequence_byte_offset = 0;
+            stream->capture_sequence_next_frame++;
+            stream->capture_sequence_frames_epoch++;
+        }
+    }
 }
 
