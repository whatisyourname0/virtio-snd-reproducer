+/* Complete one held capture descriptor after its virtual-time deadline. */
+static void virtio_snd_test_capture_cb(void *opaque)
+{
+    VirtIOSound *s = VIRTIO_SND(opaque);
+    VirtIOSoundPCMBuffer *buffer = s->test_capture_buffer;
+    virtio_snd_pcm_status status = { 0 };
+    g_autofree uint8_t *payload = NULL;
+    size_t capacity;
+
+    if (!buffer) {
+        return;
+    }
+
+    capacity = iov_size(buffer->elem->in_sg, buffer->elem->in_num);
+    if (capacity < sizeof(status)) {
+        status.status = cpu_to_le32(VIRTIO_SND_S_BAD_MSG);
+        iov_from_buf(buffer->elem->in_sg, buffer->elem->in_num, 0,
+                     &status, sizeof(status));
+        virtqueue_push(buffer->vq, buffer->elem, sizeof(status));
+    } else {
+        capacity -= sizeof(status);
+        payload = g_malloc(MAX(capacity, 1));
+        memset(payload, 0xa5, capacity);
+        iov_from_buf(buffer->elem->in_sg, buffer->elem->in_num, 0,
+                     payload, capacity);
+        status.status = cpu_to_le32(VIRTIO_SND_S_OK);
+        iov_from_buf(buffer->elem->in_sg, buffer->elem->in_num, capacity,
+                     &status, sizeof(status));
+        virtqueue_push(buffer->vq, buffer->elem,
+                       capacity + sizeof(status));
+    }
+    virtio_notify(VIRTIO_DEVICE(s), buffer->vq);
+    virtio_snd_pcm_buffer_free(buffer);
+    s->test_capture_buffer = NULL;
+    s->test_hold_capture_ms = 0;
+    s->test_capture_completed++;
+    error_report("virtio-snd test fixture: completed delayed capture descriptor");
