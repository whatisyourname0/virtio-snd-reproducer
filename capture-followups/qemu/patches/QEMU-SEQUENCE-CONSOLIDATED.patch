+        stream->capture_sequence_reported = true;
+    }
+
+    for (i = 0; i < size; i++) {
+        uint32_t sample_byte = stream->capture_sequence_byte_offset %
+                               sizeof(uint16_t);
+        uint64_t channel = stream->capture_sequence_byte_offset /
+                           sizeof(uint16_t);
+        uint16_t sample = virtio_snd_capture_test_sequence_sample(
+            vsnd->capture_test_seed, stream->capture_sequence_epoch,
+            stream->capture_sequence_next_frame, channel);
+
+        data[i] = (sample >> (8 * sample_byte)) & 0xff;
+        stream->capture_sequence_byte_offset++;
+        if (stream->capture_sequence_byte_offset == frame_bytes) {
+            stream->capture_sequence_byte_offset = 0;
+            stream->capture_sequence_next_frame++;
+            stream->capture_sequence_frames_epoch++;
+        }
+    }
+}
+
+static bool virtio_snd_capture_test_reply(VirtIOSoundPCMStream *stream,
+                                          VirtIOSoundPCMBuffer *buffer)
+{
+    VirtIOSound *vsnd = stream->s;
+    virtio_snd_pcm_status status = { 0 };
+    size_t input_size = iov_size(buffer->elem->in_sg,
+                                 buffer->elem->in_num);
+    size_t capacity, frame_bytes, audio_bytes = 0, status_offset, used_len;
+    uint32_t status_code = VIRTIO_SND_S_OK;
+    bool packed = false;
+    uint32_t ordinal = vsnd->capture_test_count -
+                       vsnd->capture_test_remaining + 1;
+
+    if (vsnd->capture_test_mode == VIRTIO_SND_CAPTURE_TEST_SEQUENCE) {
+        return false;
+    }
+    if (input_size < sizeof(status)) {
+        error_report("virtio-snd capture-test: input SG smaller than status");
+        vsnd->capture_test_remaining = 0;
+        return false;
+    }
+    capacity = input_size - sizeof(status);
+    frame_bytes = (audio_format_bits(stream->as.fmt) / 8) *
+                  stream->as.nchannels;
+    if (!frame_bytes || capacity > UINT_MAX - sizeof(status) - 1) {
+        error_report("virtio-snd capture-test: invalid capacity or frame size");
+        vsnd->capture_test_remaining = 0;
+        return false;
+    }
+
+    switch (vsnd->capture_test_mode) {
+    case VIRTIO_SND_CAPTURE_TEST_FULL_FIXED:
+    case VIRTIO_SND_CAPTURE_TEST_USED_OVER:
+    case VIRTIO_SND_CAPTURE_TEST_USED_SHORT:
+        audio_bytes = capacity;
+        break;
+    case VIRTIO_SND_CAPTURE_TEST_SHORT_FIXED:
+    case VIRTIO_SND_CAPTURE_TEST_SHORT_PACKED:
+        audio_bytes = capacity - capacity % frame_bytes;
+        if (audio_bytes >= frame_bytes) {
+            audio_bytes -= frame_bytes;
+        }
+        if (!audio_bytes) {
+            error_report("virtio-snd capture-test: short response requires "
+                         "at least two frames of capacity");
+            vsnd->capture_test_remaining = 0;
+            return false;
+        }
+        packed = vsnd->capture_test_mode ==
+                 VIRTIO_SND_CAPTURE_TEST_SHORT_PACKED;
+        break;
+    case VIRTIO_SND_CAPTURE_TEST_SHORT_STRADDLE:
+        if (stream->as.fmt != AUDIO_FORMAT_S16 ||
+            stream->as.nchannels != 1 || frame_bytes != 2 ||
+            capacity < 4 || capacity % 2) {
+            error_report("virtio-snd capture-test: short-straddle requires "
+                         "mono S16 and an even capacity");
+            vsnd->capture_test_remaining = 0;
+            return false;
+        }
+        audio_bytes = capacity - 4;
+        packed = true;
+        break;
+    case VIRTIO_SND_CAPTURE_TEST_EMPTY_FIXED:
+    case VIRTIO_SND_CAPTURE_TEST_EMPTY_PACKED:
+        packed = vsnd->capture_test_mode ==
+                 VIRTIO_SND_CAPTURE_TEST_EMPTY_PACKED;
+        break;
+    case VIRTIO_SND_CAPTURE_TEST_MISALIGNED:
+        audio_bytes = capacity - capacity % frame_bytes;
+        if (audio_bytes) {
+            audio_bytes--;
+        }
+        if (!audio_bytes || audio_bytes % frame_bytes == 0) {
+            error_report("virtio-snd capture-test: cannot form "
+                         "misaligned payload");
+            vsnd->capture_test_remaining = 0;
+            return false;
+        }
+        break;
+    case VIRTIO_SND_CAPTURE_TEST_BAD_STATUS:
+        audio_bytes = capacity;
+        status_code = VIRTIO_SND_S_BAD_MSG;
+        break;
+    case VIRTIO_SND_CAPTURE_TEST_NONE:
+    default:
+        return false;
+    }
+
+    if (audio_bytes > capacity) {
+        error_report("virtio-snd capture-test: payload exceeds data SG");
+        vsnd->capture_test_remaining = 0;
+        return false;
+    }
+
+    memset(buffer->data, 0x5a, audio_bytes);
+    if (audio_bytes &&
+        iov_from_buf(buffer->elem->in_sg, buffer->elem->in_num, 0,
+                     buffer->data, audio_bytes) != audio_bytes) {
+        error_report("virtio-snd capture-test: short PCM SG write");
+        vsnd->capture_test_remaining = 0;
+        return false;
+    }
+    status.status = cpu_to_le32(status_code);
+    status.latency_bytes = 0;
+    status_offset = packed ? audio_bytes : capacity;
+    if (iov_from_buf(buffer->elem->in_sg, buffer->elem->in_num,
+                     status_offset, &status, sizeof(status)) !=
+        sizeof(status)) {
+        error_report("virtio-snd capture-test: short status SG write");
+        vsnd->capture_test_remaining = 0;
+        return false;
+    }
+
+    switch (vsnd->capture_test_mode) {
+    case VIRTIO_SND_CAPTURE_TEST_USED_SHORT:
+        used_len = sizeof(status) - 1;
+        break;
+    case VIRTIO_SND_CAPTURE_TEST_USED_OVER:
+        used_len = capacity + sizeof(status) + 1;
+        break;
+    default:
+        used_len = audio_bytes + sizeof(status);
+        break;
+    }
+
+    virtqueue_push(buffer->vq, buffer->elem, (uint32_t)used_len);
+    virtio_notify(VIRTIO_DEVICE(stream->s), buffer->vq);
+    QSIMPLEQ_REMOVE(&stream->queue, buffer, VirtIOSoundPCMBuffer, entry);
+    virtio_snd_pcm_buffer_free(buffer);
+    vsnd->capture_test_remaining--;
+    if (vsnd->capture_test_mode != VIRTIO_SND_CAPTURE_TEST_SEQUENCE) {
+        info_report("virtio-snd capture-test reply: mode=%s stream=%" PRIu32
+                    " item=%" PRIu32 "/%" PRIu32 " after=%" PRIu32
+                    " seen=%" PRIu32 " audio=%zu used=%zu status=0x%08" PRIx32
+                    " remaining=%" PRIu32 " t_ms=%" PRIi64,
+                    virtio_snd_capture_test_mode_name(vsnd->capture_test_mode),
+                    stream->id, ordinal, vsnd->capture_test_count,
+                    vsnd->capture_test_after, vsnd->capture_test_seen,
+                    audio_bytes, used_len, status_code,
+                    vsnd->capture_test_remaining,
+                    qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL));
+    }
+    return true;
+}
+
+static void virtio_snd_capture_test_delay_cancel_locked(VirtIOSound *vsnd,
+                                                         bool all,
+                                                         uint32_t stream_id)
+{
+    if (!vsnd->capture_test_delay_pending ||
+        (!all && vsnd->capture_test_delay_stream_id != stream_id)) {
+        return;
+    }
+
+    timer_del(vsnd->capture_test_delay_timer);
+    vsnd->capture_test_delay_pending = false;
+    vsnd->capture_test_delay_stream_id = UINT32_MAX;
+    if (vsnd->capture_test_remaining) {
+        vsnd->capture_test_delay_started = false;
+    }
+}
+
+static void virtio_snd_capture_test_delay_cb(void *opaque)
+{
+    VirtIOSound *vsnd = opaque;
+    VirtIOSoundPCMStream *stream;
+    VirtIOSoundPCMBuffer *buffer;
+    bool response_attempted = false;
+    bool reactivate = false;
+    int64_t now_ms;
+
+    qemu_mutex_lock(&vsnd->capture_test_mutex);
+    if (!vsnd->capture_test_delay_pending ||
+        vsnd->capture_test_shutting_down) {
+        qemu_mutex_unlock(&vsnd->capture_test_mutex);
+        return;
+    }
+
+    now_ms = qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL);
+    info_report("virtio-snd capture-test trace: delay-expired t_ms=%" PRIi64
+                " elapsed_ms=%" PRIi64 " stream=%" PRIu32,
+                now_ms, now_ms - vsnd->capture_test_delay_armed_at_ms,
+                vsnd->capture_test_delay_stream_id);
+    stream = virtio_snd_pcm_get_stream(vsnd,
+                                      vsnd->capture_test_delay_stream_id);
+    if (stream) {
+        WITH_QEMU_LOCK_GUARD(&stream->queue_mutex) {
+            reactivate = stream->active;
+            if (virtio_snd_capture_test_trace_allow(vsnd)) {
+                buffer = QSIMPLEQ_FIRST(&stream->queue);
+                info_report("virtio-snd capture-test trace: delay-queue"
+                            " t_ms=%" PRIi64 " active=%d depth=%" PRIu32
+                            " head_size=%zu due=%d ready=%d",
+                            qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL),
+                            stream->active,
+                            virtio_snd_capture_test_queue_depth(stream),
+                            buffer ? buffer->size : 0,
+                            virtio_snd_capture_test_due(stream),
+                            buffer && virtio_queue_ready(buffer->vq));
+            }
+            if (stream->active && !QSIMPLEQ_EMPTY(&stream->queue)) {
+                buffer = QSIMPLEQ_FIRST(&stream->queue);
+                if (virtio_queue_ready(buffer->vq) &&
+                    virtio_snd_capture_test_due(stream)) {
+                    size_t input_size = iov_size(buffer->elem->in_sg,
+                                                 buffer->elem->in_num);
+                    size_t capacity = input_size >= sizeof(virtio_snd_pcm_status)
+                        ? input_size - sizeof(virtio_snd_pcm_status) : 0;
+
+                    info_report("virtio-snd capture-test delay expired: "
+                                "mode=%s stream=%" PRIu32 " delay_ms=%" PRIu32
+                                " capacity=%zu",
+                                virtio_snd_capture_test_mode_name(
+                                    vsnd->capture_test_mode),
+                                stream->id, vsnd->capture_test_delay_ms,
+                                capacity);
+                    response_attempted =
+                        virtio_snd_capture_test_reply(stream, buffer);
+                    if (response_attempted && vsnd->capture_test_pause_after) {
+                        vsnd->capture_test_rx_paused = true;
+                        vsnd->capture_test_pause_stream_id = stream->id;
+                        info_report("virtio-snd capture-test RX paused after "
+                                    "delayed reply: stream=%" PRIu32
+                                    " t_ms=%" PRIi64,
+                                    stream->id,
+                                    qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL));
+                    }
+                    if (response_attempted &&
+                        virtio_snd_capture_test_trace_allow(vsnd)) {
+                        buffer = QSIMPLEQ_FIRST(&stream->queue);
+                        info_report("virtio-snd capture-test trace: reply-done"
+                                    " t_ms=%" PRIi64 " depth=%" PRIu32
+                                    " head_size=%zu remaining=%" PRIu32,
+                                    qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL),
+                                    virtio_snd_capture_test_queue_depth(stream),
+                                    buffer ? buffer->size : 0,
+                                    vsnd->capture_test_remaining);
+                    }
+                }
+            }
+        }
+    }
+
+    vsnd->capture_test_delay_pending = false;
+    vsnd->capture_test_delay_stream_id = UINT32_MAX;
+    if (!response_attempted && vsnd->capture_test_remaining) {
+        vsnd->capture_test_delay_started = false;
+    }
+    if (reactivate && !vsnd->capture_test_shutting_down &&
+        !vsnd->capture_test_rx_paused) {
+        audio_be_set_active_in(vsnd->audio_be, stream->voice.in, true);
+        if (virtio_snd_capture_test_trace_allow(vsnd)) {
+            info_report("virtio-snd capture-test trace: backend-reactivated"
+                        " t_ms=%" PRIi64 " stream=%" PRIu32 " active=%d",
+                        qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL), stream->id,
+                        stream->active);
+        }
+    }
+    qemu_mutex_unlock(&vsnd->capture_test_mutex);
+}
