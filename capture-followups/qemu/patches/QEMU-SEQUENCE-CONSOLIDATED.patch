+static const char *virtio_snd_capture_test_mode_name(
+    VirtIOSoundCaptureTestMode mode)
+{
+    switch (mode) {
+    case VIRTIO_SND_CAPTURE_TEST_FULL_FIXED:
+        return "full-fixed";
+    case VIRTIO_SND_CAPTURE_TEST_SHORT_FIXED:
+        return "short-fixed";
+    case VIRTIO_SND_CAPTURE_TEST_SHORT_PACKED:
+        return "short-packed";
+    case VIRTIO_SND_CAPTURE_TEST_SHORT_STRADDLE:
+        return "short-straddle";
+    case VIRTIO_SND_CAPTURE_TEST_EMPTY_FIXED:
+        return "empty-fixed";
+    case VIRTIO_SND_CAPTURE_TEST_EMPTY_PACKED:
+        return "empty-packed";
+    case VIRTIO_SND_CAPTURE_TEST_USED_SHORT:
+        return "used-short";
+    case VIRTIO_SND_CAPTURE_TEST_USED_OVER:
+        return "used-over";
+    case VIRTIO_SND_CAPTURE_TEST_MISALIGNED:
+        return "misaligned";
+    case VIRTIO_SND_CAPTURE_TEST_BAD_STATUS:
+        return "bad-status";
+    case VIRTIO_SND_CAPTURE_TEST_SEQUENCE:
+        return "sequence";
+    case VIRTIO_SND_CAPTURE_TEST_NONE:
+    default:
+        return "disabled";
+    }
+}
+
+static bool virtio_snd_capture_test_parse_u32(const char *key,
+                                              const char *text,
+                                              uint32_t *value,
+                                              Error **errp)
+{
+    uint64_t parsed;
+    const char *end;
+
+    if (!*text || qemu_strtou64(text, &end, 10, &parsed) || *end ||
+        parsed > VIRTIO_SND_CAPTURE_TEST_LIMIT) {
+        error_setg(errp, "Invalid %s value in QEMU_VIRTIO_SND_CAPTURE_TEST",
+                   key);
+        return false;
+    }
+    *value = parsed;
+    return true;
+}
+
+static bool virtio_snd_capture_test_parse_u64(const char *key,
+                                              const char *text,
+                                              uint64_t *value,
+                                              Error **errp)
+{
+    uint64_t parsed;
+    const char *end;
+
+    if (!*text || qemu_strtou64(text, &end, 0, &parsed) || *end) {
+        error_setg(errp, "Invalid %s value in QEMU_VIRTIO_SND_CAPTURE_TEST",
+                   key);
+        return false;
+    }
+    *value = parsed;
+    return true;
+}
+
+static bool virtio_snd_capture_test_configure(VirtIOSound *vsnd,
+                                               Error **errp)
+{
+    const char *config = g_getenv("QEMU_VIRTIO_SND_CAPTURE_TEST");
+    g_auto(GStrv) tokens = NULL;
+    bool have_after = false, have_count = false, have_epoch = false;
+    bool have_frame = false, have_seed = false, valid = true;
+    size_t i;
+
+    if (!config || !*config) {
+        return true;
+    }
+
+    tokens = g_strsplit(config, ",", -1);
+    g_strstrip(tokens[0]);
+    if (!tokens[0] || !*tokens[0]) {
+        error_setg(errp, "Empty mode in QEMU_VIRTIO_SND_CAPTURE_TEST");
+        return false;
+    }
+
+    if (g_str_equal(tokens[0], "full-fixed")) {
+        vsnd->capture_test_mode = VIRTIO_SND_CAPTURE_TEST_FULL_FIXED;
+    } else if (g_str_equal(tokens[0], "short-fixed")) {
+        vsnd->capture_test_mode = VIRTIO_SND_CAPTURE_TEST_SHORT_FIXED;
+    } else if (g_str_equal(tokens[0], "short-packed")) {
+        vsnd->capture_test_mode = VIRTIO_SND_CAPTURE_TEST_SHORT_PACKED;
+    } else if (g_str_equal(tokens[0], "short-straddle")) {
+        vsnd->capture_test_mode = VIRTIO_SND_CAPTURE_TEST_SHORT_STRADDLE;
+    } else if (g_str_equal(tokens[0], "empty-fixed")) {
+        vsnd->capture_test_mode = VIRTIO_SND_CAPTURE_TEST_EMPTY_FIXED;
+    } else if (g_str_equal(tokens[0], "empty-packed")) {
+        vsnd->capture_test_mode = VIRTIO_SND_CAPTURE_TEST_EMPTY_PACKED;
+    } else if (g_str_equal(tokens[0], "used-short")) {
+        vsnd->capture_test_mode = VIRTIO_SND_CAPTURE_TEST_USED_SHORT;
+    } else if (g_str_equal(tokens[0], "used-over")) {
+        vsnd->capture_test_mode = VIRTIO_SND_CAPTURE_TEST_USED_OVER;
+    } else if (g_str_equal(tokens[0], "misaligned")) {
+        vsnd->capture_test_mode = VIRTIO_SND_CAPTURE_TEST_MISALIGNED;
+    } else if (g_str_equal(tokens[0], "bad-status")) {
+        vsnd->capture_test_mode = VIRTIO_SND_CAPTURE_TEST_BAD_STATUS;
+    } else if (g_str_equal(tokens[0], "sequence")) {
+        vsnd->capture_test_mode = VIRTIO_SND_CAPTURE_TEST_SEQUENCE;
+        vsnd->capture_test_count = VIRTIO_SND_CAPTURE_TEST_LIMIT;
+        vsnd->capture_test_seed = VIRTIO_SND_SEQUENCE_DEFAULT_SEED;
+    } else {
+        error_setg(errp, "Unknown mode '%s' in QEMU_VIRTIO_SND_CAPTURE_TEST",
+                   tokens[0]);
+        return false;
+    }
+
+    vsnd->capture_test_count = vsnd->capture_test_mode ==
+                               VIRTIO_SND_CAPTURE_TEST_SEQUENCE
+                                   ? VIRTIO_SND_CAPTURE_TEST_LIMIT : 1;
+    for (i = 1; tokens[i]; i++) {
+        char *equals = strchr(tokens[i], '=');
+        uint32_t parsed;
+        const char *key, *value;
+
+        if (!equals) {
+            error_setg(errp,
+                       "Expected key=value in "
+                       "QEMU_VIRTIO_SND_CAPTURE_TEST");
+            valid = false;
+            break;
+        }
+        *equals = '\0';
+        key = g_strstrip(tokens[i]);
+        value = g_strstrip(equals + 1);
+        if (g_str_equal(key, "after") && !have_after) {
+            have_after = true;
+            valid = virtio_snd_capture_test_parse_u32(key, value, &parsed,
+                                                       errp);
+            if (valid) {
+                vsnd->capture_test_after = (uint32_t)parsed;
+            }
+        } else if (g_str_equal(key, "count") && !have_count) {
+            have_count = true;
+            valid = virtio_snd_capture_test_parse_u32(key, value, &parsed,
+                                                       errp);
+            if (valid && parsed) {
+                vsnd->capture_test_count = (uint32_t)parsed;
+            } else if (valid) {
+                error_setg(errp,
+                           "count must be greater than zero in "
+                           "QEMU_VIRTIO_SND_CAPTURE_TEST");
+                valid = false;
+            }
+        } else if (g_str_equal(key, "epoch") && !have_epoch &&
+                   vsnd->capture_test_mode ==
+                       VIRTIO_SND_CAPTURE_TEST_SEQUENCE) {
+            have_epoch = true;
+            valid = virtio_snd_capture_test_parse_u64(
+                key, value, &vsnd->capture_test_initial_epoch, errp);
+        } else if (g_str_equal(key, "frame") && !have_frame &&
+                   vsnd->capture_test_mode ==
+                       VIRTIO_SND_CAPTURE_TEST_SEQUENCE) {
+            have_frame = true;
+            valid = virtio_snd_capture_test_parse_u64(
+                key, value, &vsnd->capture_test_initial_frame, errp);
+        } else if (g_str_equal(key, "seed") && !have_seed &&
+                   vsnd->capture_test_mode ==
+                       VIRTIO_SND_CAPTURE_TEST_SEQUENCE) {
+            have_seed = true;
+            valid = virtio_snd_capture_test_parse_u64(
+                key, value, &vsnd->capture_test_seed, errp);
+        } else {
+            error_setg(errp,
+                       "Unknown or duplicate key '%s' in "
+                       "QEMU_VIRTIO_SND_CAPTURE_TEST",
+                       key);
+            valid = false;
+        }
+        if (!valid) {
+            break;
+        }
+    }
+
+    if (valid) {
+        if (vsnd->capture_test_mode == VIRTIO_SND_CAPTURE_TEST_SEQUENCE &&
+            vsnd->capture_test_after) {
+            error_setg(errp, "sequence mode does not support after=N in "
+                       "QEMU_VIRTIO_SND_CAPTURE_TEST");
+            valid = false;
+        }
+    }
+    if (valid) {
+        vsnd->capture_test_remaining = vsnd->capture_test_count;
+        info_report("virtio-snd capture-test enabled: mode=%s after=%" PRIu32
+                    " count=%" PRIu32 " epoch=%" PRIu64
+                    " frame=%" PRIu64 " seed=0x%016" PRIx64,
+                    virtio_snd_capture_test_mode_name(vsnd->capture_test_mode),
+                    vsnd->capture_test_after, vsnd->capture_test_count,
+                    vsnd->capture_test_initial_epoch,
+                    vsnd->capture_test_initial_frame,
+                    vsnd->capture_test_seed);
+    }
+    return valid;
+}
