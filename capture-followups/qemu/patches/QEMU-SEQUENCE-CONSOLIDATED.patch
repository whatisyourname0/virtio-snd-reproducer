+static const char *virtio_snd_pcm_control_name(uint32_t code,
+                                               unsigned int *index)
+{
+    switch (code) {
+    case VIRTIO_SND_R_PCM_SET_PARAMS:
+        *index = 0;
+        return "set_params";
+    case VIRTIO_SND_R_PCM_PREPARE:
+        *index = 1;
+        return "prepare";
+    case VIRTIO_SND_R_PCM_RELEASE:
+        *index = 2;
+        return "release";
+    case VIRTIO_SND_R_PCM_START:
+        *index = 3;
+        return "start";
+    case VIRTIO_SND_R_PCM_STOP:
+        *index = 4;
+        return "stop";
+    default:
+        return NULL;
+    }
+}
+
+static bool virtio_snd_ctrl_test_configure(VirtIOSound *vsnd, Error **errp)
+{
+    const char *config = g_getenv("QEMU_VIRTIO_SND_CTRL_TEST");
+    g_auto(GStrv) tokens = NULL;
+    uint64_t parsed;
+    uint32_t ordinal, delay_ms;
+    const char *end;
+    unsigned int index;
+    const char *name;
+
+    if (!config || !*config) {
+        return true;
+    }
+
+    tokens = g_strsplit(config, ",", -1);
+    if (g_strv_length(tokens) != 3) {
+        error_setg(errp,
+                   "Expected command,ordinal,delay_ms in "
+                   "QEMU_VIRTIO_SND_CTRL_TEST");
+        return false;
+    }
+    g_strstrip(tokens[0]);
+    g_strstrip(tokens[1]);
+    g_strstrip(tokens[2]);
+
+    if (g_str_equal(tokens[0], "set_params")) {
+        vsnd->ctrl_test_code = VIRTIO_SND_R_PCM_SET_PARAMS;
+    } else if (g_str_equal(tokens[0], "prepare")) {
+        vsnd->ctrl_test_code = VIRTIO_SND_R_PCM_PREPARE;
+    } else if (g_str_equal(tokens[0], "release")) {
+        vsnd->ctrl_test_code = VIRTIO_SND_R_PCM_RELEASE;
+    } else if (g_str_equal(tokens[0], "start")) {
+        vsnd->ctrl_test_code = VIRTIO_SND_R_PCM_START;
+    } else if (g_str_equal(tokens[0], "stop")) {
+        vsnd->ctrl_test_code = VIRTIO_SND_R_PCM_STOP;
+    } else {
+        error_setg(errp, "Unknown PCM command in QEMU_VIRTIO_SND_CTRL_TEST");
+        return false;
+    }
+
+    if (!*tokens[1] || qemu_strtou64(tokens[1], &end, 10, &parsed) || *end ||
+        !parsed || parsed > 4096) {
+        error_setg(errp, "Invalid command ordinal in QEMU_VIRTIO_SND_CTRL_TEST");
+        return false;
+    }
+    ordinal = parsed;
+    if (!*tokens[2] || qemu_strtou64(tokens[2], &end, 10, &parsed) || *end ||
+        !parsed || parsed > 10000) {
+        error_setg(errp, "Invalid delay in QEMU_VIRTIO_SND_CTRL_TEST");
+        return false;
+    }
+    delay_ms = parsed;
+
+    vsnd->ctrl_test_ordinal = ordinal;
+    vsnd->ctrl_test_delay_ms = delay_ms;
+    name = virtio_snd_pcm_control_name(vsnd->ctrl_test_code, &index);
+    info_report("virtio-snd control-test enabled: command=%s ordinal=%" PRIu32
+                " delay_ms=%" PRIu32, name, ordinal, delay_ms);
+    return true;
+}
+
+static bool virtio_snd_capture_test_delay_configure(VirtIOSound *vsnd,
+                                                     Error **errp)
+{
+    const char *config =
+        g_getenv("QEMU_VIRTIO_SND_CAPTURE_TEST_DELAY_MS");
+    uint64_t parsed;
+    const char *end;
+
+    if (!config || !*config) {
+        return true;
+    }
+    if (vsnd->capture_test_mode != VIRTIO_SND_CAPTURE_TEST_SHORT_FIXED &&
+        vsnd->capture_test_mode != VIRTIO_SND_CAPTURE_TEST_SHORT_PACKED) {
+        error_setg(errp,
+                   "QEMU_VIRTIO_SND_CAPTURE_TEST_DELAY_MS requires "
+                   "short-fixed or short-packed mode");
+        return false;
+    }
+    if (vsnd->capture_test_count != 1) {
+        error_setg(errp,
+                   "QEMU_VIRTIO_SND_CAPTURE_TEST_DELAY_MS requires count=1");
+        return false;
+    }
+    if (qemu_strtou64(config, &end, 10, &parsed) || *end || !parsed ||
+        parsed > VIRTIO_SND_CAPTURE_TEST_DELAY_MAX_MS) {
+        error_setg(errp,
+                   "Invalid value in QEMU_VIRTIO_SND_CAPTURE_TEST_DELAY_MS "
+                   "(expected 1..%u)",
+                   VIRTIO_SND_CAPTURE_TEST_DELAY_MAX_MS);
+        return false;
+    }
+
+    vsnd->capture_test_delay_ms = (uint32_t)parsed;
+    info_report("virtio-snd capture-test delay enabled: mode=%s "
+                "delay_ms=%" PRIu32,
+                virtio_snd_capture_test_mode_name(vsnd->capture_test_mode),
+                vsnd->capture_test_delay_ms);
+    return true;
+}
+
+static bool virtio_snd_capture_test_pause_configure(VirtIOSound *vsnd,
+                                                    Error **errp)
+{
+    const char *config =
+        g_getenv("QEMU_VIRTIO_SND_CAPTURE_TEST_PAUSE_AFTER");
+
+    if (!config || !*config || g_str_equal(config, "0")) {
+        return true;
+    }
+    if (!g_str_equal(config, "1")) {
+        error_setg(errp,
+                   "Invalid value in QEMU_VIRTIO_SND_CAPTURE_TEST_PAUSE_AFTER "
+                   "(expected 0 or 1)");
+        return false;
+    }
+    if (!vsnd->capture_test_delay_ms ||
+        vsnd->capture_test_mode != VIRTIO_SND_CAPTURE_TEST_SHORT_PACKED ||
+        vsnd->capture_test_count != 1 || vsnd->capture_test_after > 1) {
+        error_setg(errp,
+                   "QEMU_VIRTIO_SND_CAPTURE_TEST_PAUSE_AFTER=1 requires "
+                   "short-packed, after=0 or 1, count=1, and delay_ms");
+        return false;
+    }
+
+    vsnd->capture_test_pause_after = true;
+    info_report("virtio-snd capture-test pause-after enabled: "
+                "mode=short-packed after=%" PRIu32 " count=1 delay_ms=%" PRIu32,
+                vsnd->capture_test_after, vsnd->capture_test_delay_ms);
+    return true;
+}
 
