+static uint16_t virtio_snd_capture_test_sequence_sample(uint64_t seed,
+                                                         uint64_t epoch,
+                                                         uint64_t frame,
+                                                         uint64_t channel)
+{
+    uint64_t x = seed ^ (epoch * VIRTIO_SND_SEQUENCE_EPOCH_MUL) ^
+                 (frame * VIRTIO_SND_SEQUENCE_FRAME_MUL) ^
+                 (channel * VIRTIO_SND_SEQUENCE_CHANNEL_MUL);
+
+    x ^= x >> 30;
+    x *= UINT64_C(0xbf58476d1ce4e5b9);
+    x ^= x >> 27;
+    x *= UINT64_C(0x94d049bb133111eb);
+    x ^= x >> 31;
+    return (uint16_t)(x >> 48);
+}
