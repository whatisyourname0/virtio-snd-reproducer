+    virtio_snd_process_cmdq(s);
+    s->test_control_command = NULL;
+    s->test_control_pending = 0;
+    s->test_control_completed++;
+    error_report("virtio-snd test fixture: completed delayed control request code=0x%04x",
+                 code);
