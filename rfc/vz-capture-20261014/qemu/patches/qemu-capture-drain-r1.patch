+static void virtio_snd_capture_test_delay_cb(void *opaque)
+{
+    VirtIOSound *vsnd = opaque;
+    VirtIOSoundPCMStream *stream;
+    VirtIOSoundPCMBuffer *buffer;
+    bool response_attempted = false;
+    bool reactivate = false;
+    int64_t now_ms;
+
+    qemu_mutex_lock(&vsnd->capture_test_mutex);
+    if (!vsnd->capture_test_delay_pending ||
+        vsnd->capture_test_shutting_down) {
+        qemu_mutex_unlock(&vsnd->capture_test_mutex);
+        return;
+    }
+
+    now_ms = qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL);
+    info_report("virtio-snd capture-test trace: delay-expired t_ms=%" PRIi64
+                " elapsed_ms=%" PRIi64 " stream=%" PRIu32,
+                now_ms, now_ms - vsnd->capture_test_delay_armed_at_ms,
+                vsnd->capture_test_delay_stream_id);
+    stream = virtio_snd_pcm_get_stream(vsnd,
+                                      vsnd->capture_test_delay_stream_id);
+    if (stream) {
+        WITH_QEMU_LOCK_GUARD(&stream->queue_mutex) {
+            reactivate = stream->active;
+            if (virtio_snd_capture_test_trace_allow(vsnd)) {
+                buffer = QSIMPLEQ_FIRST(&stream->queue);
+                info_report("virtio-snd capture-test trace: delay-queue"
+                            " t_ms=%" PRIi64 " active=%d depth=%" PRIu32
+                            " head_size=%zu due=%d ready=%d",
+                            qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL),
+                            stream->active,
+                            virtio_snd_capture_test_queue_depth(stream),
+                            buffer ? buffer->size : 0,
+                            virtio_snd_capture_test_due(stream),
+                            buffer && virtio_queue_ready(buffer->vq));
+            }
+            if (stream->active && !QSIMPLEQ_EMPTY(&stream->queue)) {
+                buffer = QSIMPLEQ_FIRST(&stream->queue);
+                if (virtio_queue_ready(buffer->vq) &&
+                    virtio_snd_capture_test_due(stream)) {
+                    size_t input_size = iov_size(buffer->elem->in_sg,
+                                                 buffer->elem->in_num);
+                    size_t capacity = input_size >= sizeof(virtio_snd_pcm_status)
+                        ? input_size - sizeof(virtio_snd_pcm_status) : 0;
+
+                    info_report("virtio-snd capture-test delay expired: "
+                                "mode=%s stream=%" PRIu32 " delay_ms=%" PRIu32
+                                " capacity=%zu",
+                                virtio_snd_capture_test_mode_name(
+                                    vsnd->capture_test_mode),
+                                stream->id, vsnd->capture_test_delay_ms,
+                                capacity);
+                    response_attempted =
+                        virtio_snd_capture_test_reply(stream, buffer);
+                    if (response_attempted && vsnd->capture_test_pause_after) {
+                        vsnd->capture_test_rx_paused = true;
+                        vsnd->capture_test_pause_stream_id = stream->id;
+                        info_report("virtio-snd capture-test RX paused after "
+                                    "delayed reply: stream=%" PRIu32
+                                    " t_ms=%" PRIi64,
+                                    stream->id,
+                                    qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL));
+                    }
+                    if (response_attempted &&
+                        virtio_snd_capture_test_trace_allow(vsnd)) {
+                        buffer = QSIMPLEQ_FIRST(&stream->queue);
+                        info_report("virtio-snd capture-test trace: reply-done"
+                                    " t_ms=%" PRIi64 " depth=%" PRIu32
+                                    " head_size=%zu remaining=%" PRIu32,
+                                    qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL),
+                                    virtio_snd_capture_test_queue_depth(stream),
+                                    buffer ? buffer->size : 0,
+                                    vsnd->capture_test_remaining);
+                    }
+                }
+            }
+        }
+    }
+
+    vsnd->capture_test_delay_pending = false;
+    vsnd->capture_test_delay_stream_id = UINT32_MAX;
+    if (!response_attempted && vsnd->capture_test_remaining) {
+        vsnd->capture_test_delay_started = false;
+    }
+    if (reactivate && !vsnd->capture_test_shutting_down &&
+        !vsnd->capture_test_rx_paused) {
+        audio_be_set_active_in(vsnd->audio_be, stream->voice.in, true);
+        if (virtio_snd_capture_test_trace_allow(vsnd)) {
+            info_report("virtio-snd capture-test trace: backend-reactivated"
+                        " t_ms=%" PRIi64 " stream=%" PRIu32 " active=%d",
+                        qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL), stream->id,
+                        stream->active);
+        }
+    }
+    qemu_mutex_unlock(&vsnd->capture_test_mutex);
 }
 
 
