+static uint32_t virtio_snd_capture_test_queue_depth(
+    VirtIOSoundPCMStream *stream)
+{
+    VirtIOSoundPCMBuffer *buffer;
+    uint32_t depth = 0;
+
+    QSIMPLEQ_FOREACH(buffer, &stream->queue, entry) {
+        depth++;
+    }
+    return depth;
+}
+
+static bool virtio_snd_capture_test_trace_allow(VirtIOSound *vsnd)
+{
+    if (!vsnd->capture_test_delay_ms || !vsnd->capture_test_delay_started ||
+        vsnd->capture_test_trace_events >= 32) {
+        return false;
+    }
+    vsnd->capture_test_trace_events++;
+    return true;
+}
+
+static bool virtio_snd_capture_test_control_trace_allow(VirtIOSound *vsnd)
+{
+    if (!vsnd->capture_test_delay_ms ||
+        vsnd->capture_test_control_trace_events >= 16) {
+        return false;
+    }
+    vsnd->capture_test_control_trace_events++;
